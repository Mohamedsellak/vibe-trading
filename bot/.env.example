# Copy to .env and fill in. Leave MT5_LOGIN empty to attach to the terminal that is already logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe if you have several terminals installed
MT5_PATH=

# Base symbol; the bot finds the Exness variant (XAUUSDm, XAUUSDc, ...) itself
SYMBOL=XAUUSD
# Exness MT5 server time is GMT+0. The bot verifies this against live quotes at startup.
SERVER_TZ=UTC

# Costs used by the backtest AND by lot sizing. Set them to YOUR account type:
# Exness Standard: commission 0 (cost is in the spread). Raw Spread / Zero: commission per lot per side.
COMMISSION_XAUUSD=3.5
COMMISSION_BTCUSD=0
# Pessimistic slippage per side, in price units (0.05 = 5 cents on gold)
SLIPPAGE_XAUUSD=0.05
SLIPPAGE_BTCUSD=5.0
LATENCY_MS=250
# Add to the recorded spread if your live spread is wider than the history you test on
EXTRA_SPREAD_PRICE=0

RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=1
MAX_DRAWDOWN_PCT=10.0
MAX_TRADES_PER_DAY=10
COOLDOWN_AFTER_LOSSES=3
COOLDOWN_MINUTES=60
SPREAD_MAX_MULT=2.0

# Trailing-stop variant: start once open profit = 1.0 x initial risk, lock 50% of the
# best open profit, move the stop in steps of 0.1 x risk
TRAIL_ACTIVATE_R=1.0
TRAIL_LOCK_FRACTION=0.5
TRAIL_STEP_R=0.1

MAGIC=26111701
DEVIATION_POINTS=30
